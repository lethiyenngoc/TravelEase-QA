<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="TravelEase Known Bug Suite">

    <listeners>
        <listener class-name="com.travelease.listeners.TestListener"/>
    </listeners>

    <test name="Known Bug Tests">

        <groups>
            <run>
                <include name="known-bug"/>
            </run>
        </groups>

        <classes>
            <class name="com.travelease.tests.SearchTourTest"/>
            <class name="com.travelease.tests.LoginTest"/>
        </classes>

    </test>

</suite>